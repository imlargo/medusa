// The Medusa module at the root and the application in app/ share this
// workspace, so the editor and commands run from the root resolve the app's
// Medusa import to this checkout. `./...` stops at the nested module, so
// check both with `go test ./... ./app/...`.
//
// Consumers never see this file: `go get` fetches modules from the proxy, not
// from a checkout.
go 1.27.0

use (
	.
	./app
)
